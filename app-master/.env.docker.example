# ----------------------------------------------------------------------------
# Variables d'environnement pour docker-compose (interpolation ${VAR}).
#
# Copier ce fichier en ".env" (NON versionné — ignoré par git ET docker) puis
# renseigner des valeurs FORTES et UNIQUES :
#
#     cp .env.docker.example .env
#
# Générer une clé applicative Laravel :
#     docker compose run --rm app php artisan key:generate --show
# ----------------------------------------------------------------------------

# Clé applicative Laravel (format base64:...)
APP_KEY=

# Mot de passe du compte applicatif MySQL (partagé par le service app et le service db)
DB_PASSWORD=

# Mot de passe root MySQL
DB_ROOT_PASSWORD=
